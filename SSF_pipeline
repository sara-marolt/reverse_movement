I will try again with this interpolated 
i have also inserted a 15 minute tolerance so that i dont get an interpolated point right
next to a

```{r}
library(dplyr)
library(purrr)
library(tibble)
library(lubridate)
library(amt)

d <- as.data.frame(trk_hourly) %>%
  arrange(t_)

# Set to Inf to interpolate across all gaps.
# A finite value is safer because long gaps may create unrealistic tracks.
max_gap_hours <- Inf

pieces <- map(seq_len(nrow(d) - 1), function(i) {

  p1 <- d[i, ]
  p2 <- d[i + 1, ]

  gap_hours <- as.numeric(
    difftime(p2$t_, p1$t_, units = "hours")
  )

  observed_start <- tibble(
    t_ = p1$t_,
    x_ = p1$x_,
    y_ = p1$y_,
    interpolated = FALSE
  )

  if (gap_hours <= 1 || gap_hours > max_gap_hours) {
    return(observed_start)
  }

  insert_tolerance <- minutes(15)

new_times <- seq(
  from = p1$t_ + hours(1),
  to = p2$t_ - seconds(1),
  by = "1 hour"
)

# Remove candidate times too close to either observed fix
new_times <- new_times[
  difftime(new_times, p1$t_, units = "mins") >=
    as.numeric(insert_tolerance, units = "mins") &
  difftime(p2$t_, new_times, units = "mins") >=
    as.numeric(insert_tolerance, units = "mins")
]

  fraction <- as.numeric(
    difftime(new_times, p1$t_, units = "secs")
  ) / as.numeric(
    difftime(p2$t_, p1$t_, units = "secs")
  )

  interpolated <- tibble(
    t_ = new_times,
    x_ = p1$x_ + fraction * (p2$x_ - p1$x_),
    y_ = p1$y_ + fraction * (p2$y_ - p1$y_),
    interpolated = TRUE
  )

  bind_rows(observed_start, interpolated)
})

# Add the final observed fix
d_interp <- bind_rows(
  pieces,
  tibble(
    t_ = d$t_[nrow(d)],
    x_ = d$x_[nrow(d)],
    y_ = d$y_[nrow(d)],
    interpolated = FALSE
  )
) %>%
  arrange(t_)

# Convert back to an amt track
trk_interp <- make_track(
  d_interp,
  .x = x_,
  .y = y_,
  .t = t_,
  crs = 4326,
  all_cols = TRUE
)
