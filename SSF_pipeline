Extracting the data i want 

```{r}
ssf_dat <- rnd_stps |>
  extract_covariates_var_time(
    u_r,
    when = "any",
    max_time = lubridate::hours(1),
    name_covar = "u",
    where = "end"
  ) |>
  extract_covariates_var_time(
    v_r,
    when = "any",
    max_time = lubridate::hours(1),
    name_covar = "v",
    where = "end"
  ) |>
  mutate(
    bearing = geosphere::bearing(
      cbind(x1_, y1_),
      cbind(x2_, y2_)
    ) * pi / 180,

    tailwind = u * sin(bearing) + v * cos(bearing),
    crosswind = u * cos(bearing) - v * sin(bearing),
    abs_cross = abs(crosswind),
    wind_speed = sqrt(u^2 + v^2)
  )

```
