make_stack <- function(dat, var) {
  tms <- sort(unique(dat$time))
  lst <- dat |>
    select(time, longitude, latitude, all_of(var)) |>
    group_split(time)                       # ordered by time
  r <- rast(lapply(lst, \(d) rast(d[, c("longitude", "latitude", var)],
                                  type = "xyz", crs = "EPSG:4326")))
  time(r) <- tms
  r
}

